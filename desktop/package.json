{
  "name": "usv-terminal",
  "version": "0.1.1",
  "private": true,
  "description": "USV operation terminal (Electron + TypeScript)",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "npm run typecheck:renderer && esbuild src/renderer/main.ts --bundle --outfile=dist/renderer/bundle.js --format=iife --platform=browser --target=chrome120 --sourcemap",
    "build:assets": "node tools/copy-assets.mjs",
    "build:info": "node tools/build-info.mjs",
    "build": "npm run build:main && npm run build:renderer && npm run build:assets && npm run build:info",
    "ship": "node tools/ship.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "algo:test": "cd algo && python -m pytest tests -q -p no:cacheprovider",
    "sim": "node tools/sim-boat.cjs",
    "icons": "node tools/make-icon-preview.mjs",
    "sim:check": "npm run build && node tools/sim-check.cjs",
    "slam:check": "npm run build && node tools/slam-check.cjs",
    "slam:export": "npm run build && node tools/slam-export-check.cjs",
    "smoke": "npm run build && node tools/link-smoke.cjs",
    "log:50hz": "npm run build && node tools/log-50hz-check.cjs",
    "release": "npm run build && node tools/package-release.mjs",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.10.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.28.2": true
  }
}
